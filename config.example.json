{
  "default_model": "qwen2.5-coder:14b@ollama",
  "planner": {
    "model": "gemini-2.5-flash@gemini"
  },
  "researcher": {
    "model": "gemini-2.5-flash@gemini"
  },
  "arbiter": {
    "model": "deepseek-chat@deepseek"
  },
  "endpoints": {
    "ollama": {
      "base_url": "http://localhost:11434/v1"
    },
    "gemini": {
      "base_url": "https://generativelanguage.googleapis.com/v1beta/openai",
      "api_key_env": "GEMINI_API_KEY",
      "input_price_per_million_tokens": 1.25,
      "output_price_per_million_tokens": 10.00
    },
    "deepseek": {
      "base_url": "https://api.deepseek.com/v1",
      "api_key_env": "DEEPSEEK_API_KEY",
      "input_price_per_million_tokens": 0.14,
      "output_price_per_million_tokens": 0.28
    }
  },
  "poll_interval": "30s",
  "max_iterations": 3,
  "max_cost_budget": 100000,
  "shadow_mode": true,
  "serena": {
    "command": "serena",
    "args": ["start-mcp-server"]
  },
  "sandbox": {
    "enabled": false,
    "policy_dir": "/etc/fabriquilla/sandbox-policies",
    "image": "factory-go:latest"
  },
  "eval": {
    "cases_dir": "tests/golden",
    "runs_per_case": 0,
    "timeout_per_run": "5m",
    "results_dir": "eval-results"
  },
  "repos": [
    {
      "owner": "your-org",
      "repo": "your-repo",
      "app_id": 123456,
      "installation_id": 789012
    }
  ]
}
