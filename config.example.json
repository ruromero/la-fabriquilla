{
  "inference": {
    "base_url": "http://ollama.ai.svc.cluster.local:11434/v1"
  },
  "poll_interval": "30s",
  "max_iterations": 3,
  "max_cost_budget": 100000,
  "shadow_mode": true,
  "planner": {
    "base_url": "https://generativelanguage.googleapis.com/v1beta/openai",
    "model": "gemini-2.5-flash"
  },
  "arbiter": {
    "base_url": "https://api.deepseek.com/v1",
    "model": "deepseek-chat",
    "_comment": "Set ARBITER_API_KEY env var for authentication"
  },
  "serena": {
    "command": "serena",
    "args": ["start-mcp-server"]
  },
  "sandbox": {
    "enabled": false,
    "policy_dir": "/etc/fabriquilla/sandbox-policies",
    "image": "factory-go:latest"
  },
  "repos": [
    {
      "owner": "ruromero",
      "repo": "la-fabriquilla",
      "app_id": 123456,
      "installation_id": 789012
    },
    {
      "owner": "ruromero",
      "repo": "bunko.sh",
      "app_id": 123456,
      "installation_id": 789013
    }
  ]
}
