{
  "inference": {
    "base_url": "http://localhost:11434/v1",
    "model": "qwen2.5-coder:14b"
  },
  "poll_interval": "30s",
  "max_iterations": 3,
  "max_cost_budget": 100000,
  "shadow_mode": true,
  "planner": {
    "base_url": "https://generativelanguage.googleapis.com/v1beta/openai",
    "model": "gemini-2.5-flash"
  },
  "arbiter": {
    "base_url": "https://api.deepseek.com/v1",
    "model": "deepseek-chat",
    "_comment": "Set ARBITER_API_KEY env var for authentication",
    "input_price_per_million_tokens": 0.14,
    "output_price_per_million_tokens": 0.28
  },
  "serena": {
    "command": "serena",
    "args": ["start-mcp-server"]
  },
  "sandbox": {
    "enabled": false,
    "policy_dir": "/etc/fabriquilla/sandbox-policies",
    "image": "factory-go:latest"
  },
  "eval": {
    "cases_dir": "tests/golden",
    "runs_per_case": 0,
    "timeout_per_run": "5m",
    "results_dir": "eval-results"
  },
  "repos": [
    {
      "owner": "your-org",
      "repo": "your-repo",
      "app_id": 123456,
      "installation_id": 789012
    }
  ]
}
